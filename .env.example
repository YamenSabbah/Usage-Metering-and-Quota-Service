# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# PostgreSQL connection string
DATABASE_URL="postgresql://metering:metering_secret@localhost:5432/metering"

# API server port
PORT=3000

# PostgreSQL connection pool (keep well under the server's max_connections)
DATABASE_POOL_MAX=25
DATABASE_CONNECT_TIMEOUT_MS=10000

# Environment: development | production | test
NODE_ENV=development

# Docker Compose PostgreSQL credentials
POSTGRES_USER=metering
POSTGRES_PASSWORD=metering_secret
POSTGRES_DB=metering
